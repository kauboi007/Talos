FROM php:8.4-cli-alpine

RUN apk add --no-cache \
    bash \
    curl \
    git \
    icu-dev \
    libpng-dev \
    libzip-dev \
    oniguruma-dev \
    openssl-dev \
    unzip \
    zip \
    nodejs \
    npm \
    $PHPIZE_DEPS \
    && docker-php-ext-install \
        bcmath \
        gd \
        intl \
        mbstring \
        pcntl \
        zip \
    && pecl install \
        mongodb \
        redis \
    && docker-php-ext-enable \
        mongodb \
        redis \
    && apk del $PHPIZE_DEPS

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

EXPOSE 8000 5173

CMD ["sleep", "infinity"]